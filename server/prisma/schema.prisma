// schema.prisma — the single source of truth for our database shape.
// Prisma reads this file to (1) create/change tables via "migrations" and
// (2) generate a type-safe client we call from JavaScript.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- enums: a fixed set of allowed values ----
enum Role {
  rider
  driver
}

// Every stage a ride moves through. The DB rejects any other value.
enum RideStatus {
  requested // rider asked; no driver yet
  accepted // a driver took it; not moving yet
  in_progress // ride has started
  completed // finished
  cancelled // called off
}

// The kinds of vehicle. A rider books one; a driver owns one.
enum VehicleType {
  car
  auto
  bike
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())

  // ---- BACK-REFERENCES (virtual, not real columns) ----
  drivenRides    Ride[] // rides where this user is the DRIVER
  ridePassengers RidePassenger[] // rows where this user rides as a PASSENGER
  // A user MAY have one driver profile (only if they are a driver).
  // The "?" makes it optional; the real link/column lives on Driver.userId.
  driverProfile  Driver?

  @@map("users")
}

// A driver's vehicle profile. 1:1 with User — one profile per user at most.
// We keep these fields OUT of User so rider rows are not full of empty
// vehicle columns.
model Driver {
  id String @id @default(uuid())

  // The user this profile belongs to. @unique is what makes it ONE-to-one:
  // the database refuses a second profile for the same user.
  userId String @unique
  // The relation. onDelete: Cascade -> delete the user, delete this profile.
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Reuse of the shared enum. This is the vehicle the driver actually owns.
  vehicleType VehicleType
  // The number plate. @unique -> no two drivers can register the same plate.
  vehicleNumber String @unique

  createdAt DateTime @default(now())
  // @updatedAt -> Prisma auto-sets this to "now" on every update. Great for
  // knowing when a profile last changed.
  updatedAt DateTime @updatedAt

  @@map("drivers")
}

model Ride {
  id String @id @default(uuid())

  // ---- the DRIVER link (optional: empty until a driver accepts) ----
  driverId String?
  driver   User?   @relation(fields: [driverId], references: [id], onDelete: SetNull)

  status      RideStatus @default(requested)
  isShareable Boolean    @default(false)

  // Which service the rider chose. @default(car) backfilled the pre-existing
  // row when this column was added; new rides always set it explicitly.
  vehicleType VehicleType @default(car)

  pickupLat      Float
  pickupLng      Float
  pickupAddress  String
  dropoffLat     Float
  dropoffLng     Float
  dropoffAddress String

  routePolyline String? @db.Text

  fareTotal Decimal @db.Decimal(10, 2)

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  passengers RidePassenger[]

  @@map("rides")
}

model RidePassenger {
  id String @id @default(uuid())

  rideId String
  ride   Ride   @relation(fields: [rideId], references: [id], onDelete: Cascade)

  riderId String
  rider   User   @relation(fields: [riderId], references: [id], onDelete: Cascade)

  pickupLat  Float
  pickupLng  Float
  dropoffLat Float
  dropoffLng Float

  fareShare Decimal? @db.Decimal(10, 2)

  joinedAt DateTime @default(now())

  @@map("ride_passengers")
}
