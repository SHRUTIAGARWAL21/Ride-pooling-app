# Copy this file to ".env" and fill in real values.
# ".env" is git-ignored so secrets never reach the repo.
# This ".env.example" IS committed, so teammates know which keys they need.

# The port the server listens on.
PORT=4000

# Where the React client runs, so the server can allow its requests (CORS).
CLIENT_URL=http://localhost:5173

# Secret used to sign JWT tokens. Generate your own long random value with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Database connection string. For local dev we use a free Neon cloud Postgres.
# Get yours from the Neon dashboard; it ends with ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require

# Redis connection string (cloud Redis added in a later step).
REDIS_URL=
